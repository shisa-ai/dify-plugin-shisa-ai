# Local Dify E2E environment template.
# Copy to `.env.e2e` and fill in the real values. Never commit real values.
# In GitHub Actions these come from the protected `release` environment.

# Local Dify instance under test
DIFY_BASE_URL=http://localhost
DIFY_ADMIN_EMAIL=admin@shisa.ai
DIFY_ADMIN_PASSWORD=change-me
SHISA_API_KEY=

# Paths below are filled by the developer for local runs. The verified chat DSL
# and test audio fixtures live in the shisa-dify-workflows repository
# (fixtures/), so clone that repo and point the DSL/AUDIO paths at it.
MODEL_PKG_PATH=<path-to-built-shisa-ai-package.difypkg>
MODEL_DSL_PATH=<path-to-shisa-dify-workflows>/fixtures/shisa-model-provider-e2e.yml
AUDIO_PATH=<path-to-shisa-dify-workflows>/fixtures/test-audio.wav
